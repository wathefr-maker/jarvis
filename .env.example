# ===== Obligatoire =====
# Ta clé API Claude : https://console.anthropic.com  -> API Keys -> Create Key
ANTHROPIC_API_KEY=sk-ant-colle-ta-cle-ici

# ===== Personnalisation =====
# Comment JARVIS t'appelle
JARVIS_NOM_UTILISATEUR=Monsieur
# Modèle : claude-sonnet-5-5 (rapide, recommandé), claude-opus-5-5 (plus intelligent, plus lent et plus cher),
#          claude-haiku-5-5 (ultra rapide, économique)
JARVIS_MODELE=claude-sonnet-5-5
# Voix : fr-FR-HenriNeural (homme), fr-FR-RemyMultilingualNeural, fr-FR-DeniseNeural (femme),
#        fr-CA-ThierryNeural (québécois), fr-BE-GerardNeural, fr-CH-FabriceNeural
JARVIS_VOIX=fr-FR-HenriNeural
JARVIS_VITESSE_VOIX=+8%
# Mots qui réveillent JARVIS (séparés par des virgules)
JARVIS_MOTS_ACTIVATION=jarvis
# Secondes pendant lesquelles tu peux répondre sans redire « Jarvis »
JARVIS_FENETRE_SUIVI=8
# Taille de Whisper : tiny / base / small (recommandé) / medium (plus précis, plus lent)
JARVIS_WHISPER=small

# ===== Interface =====
JARVIS_PORT_HUD=7777
JARVIS_OUVRIR_HUD=oui

# ===== Sécurité =====
# Autoriser JARVIS à exécuter des commandes système (toujours avec ta confirmation)
JARVIS_AUTORISER_COMMANDES=oui

# ===== Maison connectée (optionnel) =====
# URL de ton Home Assistant et un « jeton d'accès longue durée » (Profil -> Sécurité)
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
